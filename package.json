{
  "name": "printmaster-web-tests",
  "version": "0.0.0",
  "private": true,
  "devDependencies": {
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "@playwright/test": "^1.63.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/common/web/__tests__/playwright/",
      "<rootDir>/.v1-backup/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.v1-backup/"
    ]
  },
  "scripts": {
    "test:js": "jest --runInBand",
    "test:playwright": "npx playwright test common/web/__tests__/playwright --config=playwright.config.js",
    "test:playwright:all": "PW_ALL_BROWSERS=1 npx playwright test common/web/__tests__/playwright --config=playwright.config.js"
  }
}
